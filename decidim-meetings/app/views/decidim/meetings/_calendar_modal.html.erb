<button class="button button__sm button__transparent-secondary mt-6 md:mt-12 md:self-start" data-dialog-open="calendarShare" role=menuitem>
  <%= t(".export_calendar") %>
  <%= icon "download-cloud-2-line", class: "fill-current" %>
</button>

<%= decidim_modal id: "calendarShare", class: "meeting-list__modal" do %>
  <div data-dialog-container>
    <%= icon "share-forward-2-line" %>
    <h2 id="dialog-title-calendarShare" tabindex="-1" data-dialog-title><%= t(".calendar_url") %></h2>

    <div class="space-y-8">
      <p id="dialog-desc-calendarShare" class="meeting-list__modal-text"><%= t(".copy_calendar_url_description") %></p>
      <p class="meeting-list__modal-text"><%= t(".copy_calendar_url_explanation") %></p>

      <div class="meeting-list__modal-input">
        <input id="urlCalendarUrl" type="text" title="<%= t(".calendar_url") %>" value="<%= "#{path}" %>" readonly>
        <button
          data-controller="clipboard-copy"
          data-clipboard-copy="#urlCalendarUrl"
          data-clipboard-copy-label="<%= t(".copy_calendar_url_copied") %>"
          data-clipboard-copy-message="<%= t(".copy_calendar_url_message") %>"
          aria-label="<%= t(".copy_calendar_url_clarification") %>">
          <%= icon "file-copy-line" %>
          <span class="sr-only"><%= t(".copy_calendar_url") %></span>
        </button>
      </div>
    </div>
  </div>
<% end %>
