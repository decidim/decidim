<div data-load-more-replies-wrapper="<%= comment.id %>"
     data-controller="load-more-replies"
     data-load-more-replies-url-value="<%= decidim_comments.comments_path %>"
     data-load-more-replies-comment-gid-value="<%= comment.to_signed_global_id.to_s %>"
     data-load-more-replies-order-value="<%= order %>"
     data-load-more-replies-offset-value="<%= offset %>"
     data-load-more-replies-per-page-value="<%= Decidim::Comments::SortedComments::DEFAULT_COMMENTS_LIMIT %>"
     class="load-more-replies">
  <button type="button"
          data-load-more-replies-target="button"
          data-action="click->load-more-replies#loadMore"
          class="button button__xs button__text-secondary">
    <span class="font-normal"><%= t("decidim.components.comments.load_more_replies") %></span>
    <%= icon "arrow-down-s-line" %>
  </button>
  <span data-load-more-replies-target="spinner" class="ml-2 hidden">
    <%= icon "loader-3-line", class: "animate-spin fill-secondary" %>
  </span>
</div>