#!/usr/bin/env ruby
require "fileutils"
require "json"

APP_ROOT = File.expand_path("..", __dir__)
APP_NAME = "decidim-development-app"

def system!(*args)
  system(*args, exception: true)
end

def configure_codespaces_host
  env_file = "/workspaces/.codespaces/shared/environment-variables.json"
  return unless File.exist?(env_file)

  app_config = "development_app/config/application.rb"
  return unless File.exist?(app_config)

  config_content = File.read(app_config)
  return if config_content.match?(/^\s+config\.hosts/)

  env_data = JSON.parse(File.read(env_file))
  hostname = env_data["CODESPACE_NAME"]
  return unless hostname

  updated_content = config_content.sub(
    /(config\.load_defaults\s+[\d.]+\s*\n)/,
    "\\1    config.hosts << \"#{hostname}.github.dev\"\n"
  )

  File.write(app_config, updated_content)
  puts "\n== Configured Codespaces host: #{hostname}.github.dev =="
end

FileUtils.chdir APP_ROOT do
  # This script is a way to set up or update your development environment automatically.
  # This script is idempotent, so that you can run it at any time and get an expectable outcome.
  # Add necessary setup steps to this file.

  puts "== Installing dependencies =="
  system! "gem install bundler --conservative"
  system("bundle check") || system!("bundle install")
  system("npm install")

  puts "\n== Preparing decidim development app =="
  system! "bundle exec rake development_app" unless Dir.exist?("development_app")

  puts "\n== Preparing database =="
  system("bin/rails db:create")

  if File.exist?("development_app/tmp/pids/server.pid")
    puts "\n== Removing the leftover pid file =="
    system("rm development_app/tmp/pids/server.pid")
  end

  configure_codespaces_host

  puts "\n== Starting application server =="
  system! "bin/dev"
end
