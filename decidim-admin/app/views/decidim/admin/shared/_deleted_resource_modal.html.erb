<%
  modal_id = "deleted-item-modal"
  resource_type_name = resource.class.model_name.human.downcase
  resource_title = translated_attribute(resource.title)
  component = Decidim::Component.with_deleted.find_by(id: resource.decidim_component_id)
  participatory_space = component&.participatory_space
%>

<div data-dialog-container>
  <div class="flex items-center gap-3">
    <%= icon "refresh-line" %>

    <h3 class="h3"
        id="dialog-title-<%= modal_id %>"
        tabindex="-1"
        data-dialog-title>
      <%= t(
            "restore_title",
            scope: "decidim.admin.manage_trash.modals",
            resource_type: resource_type_name
          ) %>
    </h3>
  </div>

  <div id="dialog-desc-<%= modal_id %>" class="mt-6">
    <% if resource.deleted_at.present? %>
      <p class="mb-6">
        <%= t(
              "deleted_at",
              scope: "decidim.admin.manage_trash.modals",
              resource_type: resource_type_name,
              date: l(resource.deleted_at, format: :short)
            ) %>
      </p>
    <% end %>

    <div class="border border-gray-3 rounded p-4 mb-4">
      <strong class="block mb-3">
        <%= t(
              "resource.details",
              scope: "decidim.admin.manage_trash.modals"
            ) %>
      </strong>

      <dl class="grid grid-cols-[auto_1fr] gap-x-3 gap-y-2">
        <dt>
          <%= t(
                "labels.title",
                scope: "decidim.admin.manage_trash.modals"
              ) %>
        </dt>
        <dd><%= resource_title %></dd>

        <% if resource.respond_to?(:authors) && resource.authors.any? %>
          <dt>
            <%= t(
                  "labels.author",
                  scope: "decidim.admin.manage_trash.modals"
                ) %>
          </dt>
          <dd><%= resource.authors.map(&:name).to_sentence %></dd>
        <% end %>

        <dt>
          <%= t(
                "labels.created",
                scope: "decidim.admin.manage_trash.modals"
              ) %>
        </dt>
        <dd><%= l(resource.created_at, format: :short) %></dd>
      </dl>
    </div>

    <div class="border border-gray-3 rounded p-4 mb-4">
      <strong class="block mb-3">
        <%= t(
              "resource.location",
              scope: "decidim.admin.manage_trash.modals"
            ) %>
      </strong>

      <dl class="grid grid-cols-[auto_1fr_auto_1fr] gap-x-3 gap-y-2">
        <% if component.present? %>
          <dt>
            <%= t(
                  "labels.component",
                  scope: "decidim.admin.manage_trash.modals"
                ) %>
          </dt>
          <dd><%= translated_attribute(component.name) %></dd>
        <% end %>

        <% if participatory_space.present? %>
          <dt>
            <%= t(
                  "labels.space",
                  scope: "decidim.admin.manage_trash.modals"
                ) %>
          </dt>
          <dd><%= translated_attribute(participatory_space.title) %></dd>
        <% end %>
      </dl>
    </div>

    <p>
      <%= t(
            "resource.restore_info",
            scope: "decidim.admin.manage_trash.modals",
            resource_type: resource_type_name
          ) %>
    </p>
  </div>
</div>

<div data-dialog-actions>
  <button type="button"
          class="button button__sm button__transparent-secondary"
          data-dialog-close="<%= modal_id %>">
    <%= icon "arrow-left-line" %>
    <%= t(
          "cancel",
          scope: "decidim.admin.manage_trash.modals"
        ) %>
  </button>

  <% if allowed_to?(:restore, resource_type, trashable_deleted_resource: resource) %>
    <%= button_to restore_path,
                  method: :patch,
                  class: "button button__sm button__secondary",
                  data: {
                    confirm: t(
                      "confirm_restore",
                      scope: "decidim.admin.manage_trash.modals"
                    )
                  } do %>
      <%= icon "refresh-line" %>
      <%= t(
            "restore_title",
            scope: "decidim.admin.manage_trash.modals",
            resource_type: resource_type_name
          ) %>
    <% end %>
  <% end %>
</div>
