<% add_decidim_page_title(t(".title")) %>

<div class="card" id="phases">
  <div class="item_show__header">
    <h1 class="item_show__header-title">
      <%= t(".title") %>
      <% if allowed_to? :create, :process_phase %>
        <%= link_to t("actions.new_process_phase", scope: "decidim.admin"), new_participatory_process_phase_path(current_participatory_process), class: "button button__sm button__secondary ml-auto" %>
      <% end %>
    </h1>
  </div>
  <% if current_participatory_process.phases.any? %>
    <div class="table-stacked">
      <table class="table-list">
        <thead>
          <tr>
            <th><%= t("models.participatory_process_phase.fields.title", scope: "decidim.admin") %></th>
            <th><%= t("models.participatory_process_phase.fields.start_date", scope: "decidim.admin") %></th>
            <th><%= t("models.participatory_process_phase.fields.end_date", scope: "decidim.admin") %></th>
            <th><%= t("models.participatory_process_phase.fields.actions", scope: "decidim.admin") %></th>
          </tr>
        </thead>
        <tbody class="sortable" data-sort-url="<%= ordering_participatory_process_phases_path(current_participatory_process) %>">
          <% current_participatory_process.phases.each do |phase| %>
            <tr data-id="<%= phase.id %>">
              <td data-label="<%= t("models.participatory_process_phase.fields.title", scope: "decidim.admin") %>">
                <div class="flex items-center gap-x-2">
                  <%= icon("draggable", class: "dragger hover:cursor-grab") %>
                  <% if phase.active? %>
                    <span class="icon-active"></span>
                  <% end %>
                  <%= link_to translated_attribute(phase.title), edit_participatory_process_phase_path(current_participatory_process, phase) %><br>
                </div>
              </td>
              <td data-label="<%= t("models.participatory_process_phase.fields.start_date", scope: "decidim.admin") %>">
                <% if phase.start_date %>
                  <%= l phase.start_date, format: :decidim_short %>
                <% end %>
              </td>
              <td data-label="<%= t("models.participatory_process_phase.fields.end_date", scope: "decidim.admin") %>">
                <% if phase.end_date %>
                  <%= l phase.end_date, format: :decidim_short %>
                <% end %>
              </td>
              <td class="table-list__actions" data-label="<%= t("models.participatory_process_phase.fields.actions", scope: "decidim.admin") %>">
                <button type="button" data-controller="dropdown" data-target="actions-process-phase-<%= phase.id %>" aria-label="<%= t("decidim.admin.actions.actions_label", resource: translated_attribute(phase.title)) %>">
                  <%= icon "more-fill", class: "text-secondary" %>
                </button>

                <div class="inline-block relative">
                  <ul id="actions-process-phase-<%= phase.id %>" class="dropdown dropdown__action" aria-hidden="true">
                    <% if allowed_to? :update, :process_phase, process_phase: phase %>
                      <li class="dropdown__item">
                        <%= link_to edit_participatory_process_phase_path(current_participatory_process, phase), class: "dropdown__button" do %>
                          <%= icon "pencil-line" %> <%= t("actions.edit", scope: "decidim.admin") %>
                        <% end %>
                      </li>

                      <hr>
                    <% end %>

                    <% if allowed_to?(:activate, :process_phase, process_phase: phase) && !phase.active? %>
                      <li class="dropdown__item">
                        <%= link_to participatory_process_phase_activate_path(current_participatory_process, phase), method: :post, class: "dropdown__button" do %>
                          <%= icon "check-line" %> <%= t("actions.activate", scope: "decidim.admin") %>
                        <% end %>
                      </li>

                      <hr>
                    <% end %>

                    <% if allowed_to? :destroy, :process_phase, process_phase: phase %>
                      <li class="dropdown__item">
                        <%= link_to participatory_process_phase_path(current_participatory_process, phase), method: :delete, data: { confirm: t("actions.confirm_destroy", scope: "decidim.admin") }, class: "dropdown__button dropdown__button--danger" do %>
                          <%= icon "delete-bin-line" %> <%= t("actions.destroy", scope: "decidim.admin") %>
                        <% end %>
                      </li>
                    <% end %>
                  </ul>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
