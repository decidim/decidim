<%= decidim_modal id: "messageErrorModal", class: "conversation-error-modal" do %>
  <div data-dialog-container>
    <h2 tabindex="-1" data-dialog-title><%= error %></h2>
    <div>
      <p><%= t(".intro") %></p>
      <p><%= messages.join("<br>") %></p>
      <p><%= t(".correct_errors") %></p>
    </div>
    <div data-dialog-actions>
      <a class="button button__sm lg:button__lg button__secondary" role="button" href="#" data-close aria-label="<%= t(".ok") %>"><%= t(".ok") %></a>
    </div>
  </div>
<% end %>
