<%
  js_configs = {
    api_path: decidim_api.root_path(locale: nil),
    icons_path: Decidim.cors_enabled ? "" : asset_pack_path("media/images/remixicon.symbol.svg"),
    messages: {
      "selfxssWarning": I18n.t("decidim.security.selfxss_warning"),
      "mentionsModal": {
        "removeRecipient": t("decidim.shared.mentions_modal.remove_recipient", name: "%name%")
      },
      "confirmUnload": t("decidim.shared.confirm_unload"),
      emojis: I18n.t("emojis").deep_transform_keys { |k| k.to_s.camelize(:lower) },
      editor: I18n.t("editor"),
      date: I18n.t("date"),
      time: I18n.t("time"),
      forms: {
        correct_errors: t("forms.correct_errors")
      },
      notifications: {
        action_error: I18n.t("decidim.notifications.action_error")
      },
      characterCounter: {
        charactersAtLeast: {
          one: t("forms.length_validator.minimum.one", count: "%count%", default: "forms.length_validator.minimum.other"),
          other: t("forms.length_validator.minimum.other", count: "%count%")
        },
        charactersLeft: {
          one: t("decidim.components.add_comment_form.remaining_characters_1", count: "%count%"),
          other: t("decidim.components.add_comment_form.remaining_characters", count: "%count%")
        }
      }
    },
    external_domain_allowlist: [current_organization.host] + current_organization.external_domain_allowlist,
    consent_cookie_name: Decidim.consent_cookie_name,
    sign_out_path: decidim.destroy_user_session_path
  }
  external_link_messages = {
    "externalLink": t("decidim.accessibility.external_link"),
    "opensInNewTab": t("decidim.accessibility.opens_in_new_tab")
  }
%>

<script>
  Decidim.config.set(<%== js_configs.to_json %>);
  Decidim.ExternalLink.configureMessages(<%== external_link_messages.to_json %>);

  // Configure LocalTime with I18n translations
  window.Decidim = window.Decidim || {};
  window.Decidim.localTimeConfig = {
    locale: "<%= I18n.locale %>",
    i18n: {
      date: {
        dayNames: <%= raw I18n.t("date.day_names").compact.to_json %>,
        abbrDayNames: <%= raw I18n.t("date.abbr_day_names").compact.to_json %>,
        monthNames: <%= raw I18n.t("date.month_names").compact.to_json %>,
        abbrMonthNames: <%= raw I18n.t("date.abbr_month_names").compact.to_json %>,

        yesterday: "<%= I18n.t("date.yesterday") %>",
        today: "<%= I18n.t("date.today") %>",
        tomorrow: "<%= I18n.t("date.tomorrow") %>",
        on: "<%= I18n.t("date.on_date") %>",

        formats: {
          default: "<%= I18n.t("date.formats.decidim_with_month_name") %>",
          thisYear: "<%= I18n.t("date.formats.decidim_with_month_name_short") %>"
        }
      },

      time: {
        am: "<%= I18n.t("time.am") %>",
        pm: "<%= I18n.t("time.pm") %>",

        singular: "<%= I18n.t("decidim.local_time.singular") %>",
        singularAn: "<%= I18n.t("decidim.local_time.singular_an") %>",

        // Format i18n key values to match local_time key structure
        elapsed: "<%= I18n.t("datetime.relative.past").gsub("%{time}", "{time}") %>",

        second: "<%= I18n.t("datetime.distance_in_words.x_seconds.one", count: 1).sub(/^1\s*/, "") %>",
        seconds: "<%= I18n.t("datetime.distance_in_words.x_seconds.other", count: "%{count}").gsub("%{count} ", "") %>",

        minute: "<%= I18n.t("datetime.distance_in_words.x_minutes.one", count: 1).sub(/^1\s*/, "") %>",
        minutes: "<%= I18n.t("datetime.distance_in_words.x_minutes.other", count: "%{count}").gsub("%{count} ", "") %>",

        hour: "<%= I18n.t("datetime.distance_in_words.x_hours.one", count: 1).sub(/^1\s*/, "") %>",
        hours: "<%= I18n.t("datetime.distance_in_words.x_hours.other", count: "%{count}").gsub("%{count} ", "") %>",

        formats: {
          default: "<%= I18n.t("time.formats.time_of_day") %>",
          default_24h: "<%= I18n.t("time.formats.time_of_day") %>"
        }
      },

      datetime: {
        at: "<%= I18n.t("decidim.local_time.at") %>",

        formats: {
          default: "<%= I18n.t("time.formats.long_with_particles") %>",
          default_24h: "<%= I18n.t("time.formats.long_with_particles") %>"
        }
      }
    }
  };
</script>
